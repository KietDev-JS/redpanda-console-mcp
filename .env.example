# Redpanda Console address. Required; there is no default.
CONSOLE_BASE_URL=https://console.example.com

# Optional bearer token. Omit if the Console is unauthenticated.
# Use a read-only Console user: this server only reads, but it cannot
# reduce the privileges of the credential you give it.
#CONSOLE_API_KEY=

# Request timeout in seconds.
#CONSOLE_TIMEOUT=60

# Set false to skip TLS verification. Disables it process-wide; use only
# against a host you control.
#CONSOLE_VERIFY_TLS=true
